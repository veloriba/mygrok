# Copy to .env and fill in. .env is gitignored.

# Base domain for tunnels (used for tunnel naming / stats; no wildcard
# cert needed without a TLS front)
DOMAIN=example.com

# Auth token (must match MYGROK_TOKEN on every client)
MYGROK_TOKEN=your-secret-token

# Image tag (defaults to the VERSION file)
MYGROK_TAG=0.3.0
