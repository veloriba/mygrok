# Copy to .env and fill in. .env is gitignored.

# mygrok server address (host:port)
# (multi mode: the container reads these variables from the environment;
# tunnels.json keeps its server/token fields empty on purpose)
MYGROK_SERVER=your-vps.com:7000

# Auth token (must match the server's MYGROK_TOKEN)
MYGROK_TOKEN=your-secret-token

# Image tag (defaults to the VERSION file)
MYGROK_TAG=0.3.0
