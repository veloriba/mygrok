# Copy to .env.server and fill in. .env.server is gitignored.

# Base domain for tunnels (wildcard cert required: *.DOMAIN)
DOMAIN=example.com

# Auth token (must match MYGROK_TOKEN on every client)
MYGROK_TOKEN=your-secret-token

# Image tag (defaults to the VERSION file)
MYGROK_TAG=0.3.0

# Optional listeners (server container uses network_mode: host):
# MYGROK_CONTROL_ADDR=:7000
# MYGROK_HTTP_ADDR=127.0.0.1:8080
# MYGROK_PORT_BASE=20000
# MYGROK_PORT_COUNT=100
