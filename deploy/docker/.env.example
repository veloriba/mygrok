# Copy to .env and fill in. .env is gitignored.

# mygrok server address (host:port)
MYGROK_SERVER=your-vps.com:7000

# Auth token (must match the server's MYGROK_TOKEN)
MYGROK_TOKEN=your-secret-token

# Multi-tunnel mode (one container, all tunnels from a tunnels.json file —
# see the commented `mygrok-multi` service in docker-compose.client.yml):
# the container reads MYGROK_SERVER / MYGROK_TOKEN from the environment
# above, so tunnels.json can keep its server/token fields empty.

# Image tag (defaults to the VERSION file)
MYGROK_TAG=0.4.0
